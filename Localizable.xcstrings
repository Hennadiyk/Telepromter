    "Regular — flowing text. In Line — one word per line. Voice — text follows your speech (video mode only)." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Normal — fließender Text. Einzeilig — ein Wort pro Zeile. Stimme — Text folgt deiner Rede (nur Videomodus)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Normal — texto fluido. En línea — una palabra por línea. Voz — el texto sigue tu discurso (solo modo vídeo)."
          }
        },
        "es-DO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Normal — texto fluido. En línea — una palabra por línea. Voz — el texto sigue tu discurso (solo modo vídeo)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Normal — texte fluide. En ligne — un mot par ligne. Voix — le texte suit votre discours (mode vidéo uniquement)."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सामान्य — प्रवाहमान टेक्स्ट। इन लाइन — प्रति पंक्ति एक शब्द। वॉइस — टेक्स्ट आपकी बोली का अनुसरण करता है (केवल वीडियो मोड)।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Normale — testo scorrevole. In linea — una parola per riga. Voce — il testo segue il tuo discorso (solo modalità video)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обычный — плавный текст. Построчно — одно слово на строку. Голос — текст следует вашей речи (только видеорежим)."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Звичайний — плаваючий текст. Построково — одне слово на рядок. Голос — текст слідує за вашим мовленням (лише відеорежим)."
          }
        }
      }
